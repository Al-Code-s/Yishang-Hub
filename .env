# 意尚智造集成平台环境变量示例
# 复制为 .env（根目录）与 backend/.env 后按需修改。
# 严禁把真实密钥、密码、个人资料提交到仓库。

# ---------- 运行环境 ----------
# development | test | staging | production
DJANGO_ENV=development
DJANGO_DEBUG=true
# 生产必须提供；可用 python -c "import secrets;print(secrets.token_urlsafe(64))" 生成
DJANGO_SECRET_KEY=2ZosukyF2pMtkLV-kDHAx5Aclv239zOGqUWLxVOYCcifrfSp8y46sclguLnxU7ys
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.49
# 必须包含实际访问来源：Vite 开发端口（5173）+ 局域网 IP 与对外端口（见下面「对外访问」）
# 该行与 DJANGO_ALLOWED_HOSTS 由 scripts/docker_network.ps1 维护，改端口 / 换网络后重跑它即可
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.49:8080
# 仅在 Nginx 等可信反向代理已设置 X-Forwarded-For 时开启
DJANGO_USE_X_FORWARDED_FOR=false
# 会话有效期（秒），默认 12 小时
SESSION_COOKIE_AGE=43200

# ---------- 对外访问（端口 / 局域网，由 scripts/docker_network.ps1 维护）----------
# 宿主端口 → 容器内 nginx 8080；被别的服务占用就改这里（改完 docker compose up -d 生效）
HTTP_PORT=8080
# 监听地址：0.0.0.0 = 本机与局域网都能访问；127.0.0.1 = 只有本机能访问
HTTP_BIND=0.0.0.0

# ---------- 数据库（MySQL 8）----------
# mysqlclient：Linux/Docker 默认 | pymysql：Windows 本地开发（无 C 编译工具链时）
DB_DRIVER=mysqlclient
DB_NAME=yishang_platform
DB_USER=yishang_app
# 部署时通过密钥管理注入，不提交真实值；应用账号不使用 root
DB_PASSWORD=qZWzCncML4dyPPaLxEdDnGTH
# 容器内 MySQL root 口令（compose 强制要求；仅编排使用）
MYSQL_ROOT_PASSWORD=hGjvuU53TU6vxeDGGwDTxKkL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_yishang_platform
DB_CONN_MAX_AGE=60

# ---------- 镜像构建 ----------
# 实测本机直连 deb.debian.org 返回 502 Bad Gateway，走阿里云镜像（换网络后可改回 deb.debian.org）
APT_MIRROR=mirrors.aliyun.com
# 前端镜像构建用的 npm 源（与 frontend/.npmrc 的开发口径一致；换网络后可留空用官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# ---------- 对象存储（S3 兼容，可选）----------
# 留空表示使用本地文件系统存储，仅适用于开发/测试
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=kq-lmi69Jfr9WNOSu4PSFrA6gVATSQVC
OBJECT_STORAGE_REGION=us-east-1

# ---------- 业务参数 ----------
YISHANG_BUSINESS_TIME_ZONE=Asia/Shanghai
YISHANG_API_PREFIX=api/v1
YISHANG_PAGE_SIZE_MAX=200
YISHANG_LOGIN_FAILURE_LIMIT=5
YISHANG_LOGIN_FAILURE_WINDOW_MINUTES=15
YISHANG_LOGIN_LOCK_MINUTES=15
YISHANG_IDEMPOTENCY_TTL_HOURS=24
# 阶段 2 库存服务启用前保持 false；默认禁止负库存
YISHANG_ALLOW_NEGATIVE_STOCK=false
YISHANG_ATTACHMENT_MAX_BYTES=20971520
YISHANG_ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.xls,.csv,.docx,.txt,.zip
YISHANG_CSP_POLICY=default-src 'self'

# ---------- 上传与日志 ----------
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
LOG_LEVEL=INFO

# ---------- 生产专用（DJANGO_ENV=production 时生效）----------
# ⚠️ 本机/内网走 HTTP 时必须是 false，否则浏览器会被 301 跳到 https 而打不开；
#    对外提供 HTTPS 服务时必须改回 true。
DJANGO_SECURE_SSL_REDIRECT=false
# ⚠️ 与上一项配套：HTTP 下必须为 false，否则登录成功后浏览器不回传会话 Cookie，
#    表现为「刚登录就被踢回登录页」。HTTPS 环境请改回 true。
DJANGO_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=2592000
CORS_ALLOWED_ORIGINS=
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# ---------- 初始化命令（仅本地/受控初始化使用，绝不提交真实值）----------
# bootstrap_system 初始管理员；生产请通过安全初始化流程设置密码
YISHANG_ADMIN_USERNAME=admin
YISHANG_ADMIN_PASSWORD=hylqs4L01yzp27SYnI6t9g
# seed_demo 演示账号密码；seed_demo 在生产环境会被拒绝执行
YISHANG_DEMO_PASSWORD=
# 仅本地初始化脚本使用的 MySQL 管理员账号，应用运行不需要
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=