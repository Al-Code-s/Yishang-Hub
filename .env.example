# 意尚智造集成平台环境变量示例
# 复制为 .env（根目录）与 backend/.env 后按需修改。
# 严禁把真实密钥、密码、个人资料提交到仓库。

# ---------- 运行环境 ----------
# development | test | staging | production
DJANGO_ENV=development
DJANGO_DEBUG=true
# 生产必须提供；可用 python -c "import secrets;print(secrets.token_urlsafe(64))" 生成
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 带协议的完整来源，必须覆盖「实际会用到的每一种访问方式」；
# 少写一个，页面能打开但登录会报 CSRF 校验未通过（Docker 部署通常要写成）：
#   http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.49:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅在 Nginx 等可信反向代理已设置 X-Forwarded-For 时开启
DJANGO_USE_X_FORWARDED_FOR=false
# 会话有效期（秒），默认 12 小时
SESSION_COOKIE_AGE=43200

# ---------- 对外访问（端口 / 局域网）----------
# 宿主端口 → 容器内 nginx 8080。被其他服务占用时改这里（改完 docker compose up -d 生效）
HTTP_PORT=80
# 监听地址：0.0.0.0 = 本机与局域网都能访问；127.0.0.1 = 只有本机能访问
HTTP_BIND=0.0.0.0
# 局域网访问还需要把本机 IP 写进 DJANGO_ALLOWED_HOSTS 与 DJANGO_CSRF_TRUSTED_ORIGINS：
# 直接跑 scripts/docker_network.ps1 会自动填好这两项（含空闲端口检测）

# ---------- 数据库（MySQL 8）----------
# mysqlclient：Linux/Docker 默认 | pymysql：Windows 本地开发（无 C 编译工具链时）
DB_DRIVER=mysqlclient
DB_NAME=yishang_platform
DB_USER=yishang_app
# 部署时通过密钥管理注入，不提交真实值；应用账号不使用 root
DB_PASSWORD=
# 容器内 MySQL root 口令（`compose.yaml` 强制要求；只给编排/运维用，与应用账号口令不同）
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_yishang_platform
DB_CONN_MAX_AGE=60

# ---------- 镜像构建 ----------
# Debian 软件源镜像，仅影响 docker 构建后端镜像时 apt 装包（默认官方源）。
# 国内网络直连 deb.debian.org 报 502 时改成国内镜像，例如 mirrors.aliyun.com
APT_MIRROR=deb.debian.org
# 前端镜像构建用的 npm 源（默认空 = npm 官方源）。国内网络不稳时用 https://registry.npmmirror.com
NPM_REGISTRY=

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# ---------- 对象存储（S3 兼容，可选）----------
# 留空表示使用本地文件系统存储，仅适用于开发/测试
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# ---------- 业务参数 ----------
YISHANG_BUSINESS_TIME_ZONE=Asia/Shanghai
YISHANG_API_PREFIX=api/v1
YISHANG_PAGE_SIZE_MAX=200
YISHANG_LOGIN_FAILURE_LIMIT=5
YISHANG_LOGIN_FAILURE_WINDOW_MINUTES=15
YISHANG_LOGIN_LOCK_MINUTES=15
YISHANG_IDEMPOTENCY_TTL_HOURS=24
# 阶段 2 库存服务启用前保持 false；默认禁止负库存
YISHANG_ALLOW_NEGATIVE_STOCK=false
YISHANG_ATTACHMENT_MAX_BYTES=20971520
YISHANG_ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.xls,.csv,.docx,.txt,.zip
YISHANG_CSP_POLICY=default-src 'self'

# ---------- 上传与日志 ----------
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
LOG_LEVEL=INFO

# ---------- 生产专用（DJANGO_ENV=production 时生效）----------
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000
# 会话与 CSRF Cookie 的 Secure 标记：默认 true（浏览器只在 HTTPS 下回传）。
# 纯内网 HTTP 部署（没有证书且已明确接受风险）才设为 false。
DJANGO_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# ---------- 初始化命令（仅本地/受控初始化使用，绝不提交真实值）----------
# bootstrap_system 初始管理员；生产请通过安全初始化流程设置密码
YISHANG_ADMIN_USERNAME=admin
YISHANG_ADMIN_PASSWORD=
# seed_demo 演示账号密码；seed_demo 在生产环境会被拒绝执行
YISHANG_DEMO_PASSWORD=
# 仅本地初始化脚本使用的 MySQL 管理员账号，应用运行不需要
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=