# 意尚智造集成平台 MySQL 补充配置
# 与 compose.yaml 中的 command 参数保持一致；此处用于显式记录数据库口径。
# ⚠️ 未在容器中实际加载验证。
# 注意：Windows 宿主上该文件会被 MySQL 判定为 world-writable（0777）并【整份忽略】，
# 因此关键参数同时写进了 compose.yaml 的 mysql command（见 docs/deployment.md §三、docs/progress.md 第 44 节）。

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'

# 严格模式：拒绝隐式截断与零日期，避免脏数据静默写入
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# 时间统一按 UTC 存储（Django USE_TZ=True）
log_timestamps = UTC

# binlog：支持时间点恢复（PITR），保留期按项目方 RPO 要求设置
server-id = 1
log-bin = mysql-bin
binlog_expire_logs_seconds = 604800

# 字符集与排序规则必须显式声明，不依赖服务器默认值
skip-character-set-client-handshake = 0

# 连接数按部署规模调整
max_connections = 200

innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

[client]
default-character-set = utf8mb4